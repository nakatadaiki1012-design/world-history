#!/bin/sh
# コミットの前に、データが壊れていないか点検する（壊れていたらコミットしない）
# 使いたいときは、パソコンでこのフォルダを開いて一度だけ：git config core.hooksPath tools/git-hooks
if git diff --cached --name-only | grep -qE '^(js/|index\.html|tools/check-data\.js)'; then
  node tools/check-data.js || { echo ""; echo "データにエラーがあるので、コミットを止めました。上のエラーを直してから、もう一度コミットしてください。"; exit 1; }
fi
